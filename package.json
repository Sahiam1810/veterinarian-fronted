{
  "name": "huellitas-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test": "node --test --experimental-strip-types tests/auth/systemRoles.test.ts tests/auth/sessionRefresh.test.ts tests/navigation/vetNavPermissions.test.ts tests/superadmin/createFullUserPassword.test.ts tests/superadmin/mapAppointmentsByStatus.test.ts tests/superadmin/mapReportesSummaryAndTopServices.test.ts tests/recepcionista/createRecepPetWithClient.test.ts tests/veterinario/registrarAtencionDiagnostics.test.ts",
    "test:auth": "node --test --experimental-strip-types \"tests/auth/**/*.test.ts\"",
    "test:superadmin": "node --test --experimental-strip-types \"tests/superadmin/**/*.test.ts\"",
    "test:recep": "node --test --experimental-strip-types \"tests/recepcionista/**/*.test.ts\"",
    "test:nav": "node --test --experimental-strip-types tests/navigation/vetNavPermissions.test.ts",
    "test:vet": "node --test --experimental-strip-types \"tests/veterinario/**/*.test.ts\"",
    "test:notifications": "node --test --experimental-strip-types \"tests/notifications/**/*.test.ts\""
  },

  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
